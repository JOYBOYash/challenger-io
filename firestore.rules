
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isUserAuthenticated() && request.auth.uid == userId;
    }

    // --- Rules for the 'users' collection ---
    match /users/{userId} {

      // --- READS ---
      // Allow any authenticated user to read from the users collection.
      // This is necessary for profile pages, search, and connection features.
      allow read: if isUserAuthenticated();

      // --- WRITES ---

      // CREATE: Allow a user to create their own document, but not one for someone else.
      // This rule is critical for signup. It ensures the document ID being created
      // MUST match the UID of the user making the request.
      allow create: if request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.username is string
                    && request.resource.data.email == request.auth.token.email;

      // UPDATE: This is the most complex rule.
      allow update: if isOwner(userId) &&
                     // Case 1: Simple profile edit (bio, skills, medallions etc.)
                     (isProfileEdit(request.resource.data, resource.data) ||
                     // Case 2: Saving/Removing a challenge
                      isChallengeUpdate(request.resource.data, resource.data) ||
                     // Case 3: Accepting/Declining a connection request
                      isManagingConnection(request.resource.data, resource.data)
                     );

      // DELETE: Don't allow clients to delete user profiles.
      allow delete: if false;
    }

    // This separate rule is CRITICAL for connection requests, which is a write
    // batch that affects multiple documents.
    match /users/{recipientId} {
       // This allows an authenticated user (the sender) to update the recipient's doc
       // ONLY if they are adding themselves to the pendingConnections list.
       allow update: if isUserAuthenticated() && isSendingRequest(recipientId);
    }


    // --- Helper Functions for Complex Update Logic ---

    // A simple profile edit only changes these specific, non-critical fields.
    function isProfileEdit(requestData, existingData) {
      return requestData.bio == request.resource.data.bio &&
             requestData.domain == request.resource.data.domain &&
             requestData.skills == request.resource.data.skills &&
             requestData.medallions == request.resource.data.medallions &&
             requestData.lastAiChallengeTimestamp == request.resource.data.lastAiChallengeTimestamp &&
             requestData.photoURL == existingData.photoURL && // Ensure core fields are not changed
             requestData.uid == existingData.uid &&
             requestData.email == existingData.email;
    }

    // When saving/removing a challenge, only the 'savedChallenges' array should change.
    function isChallengeUpdate(requestData, existingData) {
       return requestData.savedChallenges != existingData.savedChallenges &&
              requestData.keys().removeAll(['savedChallenges']).size() == existingData.keys().removeAll(['savedChallenges']).size() &&
              requestData.uid == existingData.uid; // Must not change UID
    }
    
    // When a user accepts or declines a request, they modify their own doc.
    function isManagingConnection(requestData, existingData) {
        let isAccepting = requestData.connections.size() == existingData.connections.size() + 1 &&
                          requestData.pendingConnections.size() == existingData.pendingConnections.size() - 1;
        let isDeclining = requestData.pendingConnections.size() == existingData.pendingConnections.size() - 1;
        
        let otherFieldsUnchanged = requestData.keys().removeAll(['connections', 'pendingConnections']).size() == existingData.keys().removeAll(['connections', 'pendingConnections']).size();
        
        return (isAccepting || isDeclining) && otherFieldsUnchanged && requestData.uid == existingData.uid;
    }
    
    // When sending a request, the sender is trying to update the recipient's doc.
    // We allow this ONLY if the ONLY change is adding the sender's UID to the `pendingConnections` array.
    function isSendingRequest(recipientId) {
      // The document being written to.
      let recipientDoc = get(/databases/$(database)/documents/users/$(recipientId));
      let senderId = request.auth.uid;
      
      // Ensure the only field being changed is 'pendingConnections' and it's an addition.
      let isOnlyPendingChanged = request.resource.data.keys().toSet().difference(recipientDoc.data.keys().toSet()).hasOnly(['pendingConnections']);
      
      // Check if the new pendingConnections list is exactly the old one plus the new senderId.
      let isAddingSender = request.resource.data.pendingConnections.toSet().hasAll(recipientDoc.data.pendingConnections.toSet()) &&
                           request.resource.data.pendingConnections.size() == recipientDoc.data.pendingConnections.size() + 1 &&
                           request.resource.data.pendingConnections.hasAny([senderId]);
                           
      return isOnlyPendingChanged && isAddingSender;
    }
  }
}
