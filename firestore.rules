
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rules for the 'users' collection
    match /users/{userId} {
      
      // ANYONE can read a user's public profile information.
      // This is necessary for public profile pages and user search.
      allow get: if true;

      // AUTHENTICATED users can list/query users for the search functionality.
      allow list: if request.auth != null;

      // CREATE: A user can create their own profile document.
      // The document ID must match their authentication UID.
      allow create: if request.auth != null && request.auth.uid == userId;

      // UPDATE: A user can only update their own profile.
      // They can only update specific, non-critical fields.
      // They cannot change their plan, connections, or request lists directly.
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['bio', 'domain', 'skills', 'medallions', 'savedChallenges', 'lastAiChallengeTimestamp', 'photoURL', 'username', 'pendingConnections', 'sentRequests', 'connections']);
    }
  }
}

    