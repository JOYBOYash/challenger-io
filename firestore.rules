
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isUserAuthenticated() && request.auth.uid == userId;
    }

    // --- Rules for the 'users' collection ---
    match /users/{userId} {

      // --- READS ---
      // Allow any authenticated user to read any user document
      // This is needed for profile pages, loading user data, etc.
      allow read: if isUserAuthenticated();

      // --- LIST (QUERY) ---
      // Allow authenticated users to list users for the connect page
      // Allow unauthenticated listing for username checks during signup
      allow list: if isUserAuthenticated() || true;

      // --- WRITES ---

      // CREATE: Allow a user to create their own user document upon signup.
      allow create: if isOwner(userId) && request.resource.data.uid == userId;

      // UPDATE: Allow updates with different conditions
      // 1. Owner can update their own document (with restrictions on sensitive fields)
      // 2. Any authenticated user can add/remove to connection arrays (sentRequests, pendingConnections, connections)
      allow update: if (
        // Case 1: User updating their own document
        (isOwner(userId) && 
         (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid) &&
         (!('email' in request.resource.data) || request.resource.data.email == resource.data.email))
        ||
        // Case 2: Any authenticated user updating connection arrays on ANY document
        isUserAuthenticated()
      );

      // DELETE: Don't allow clients to delete user profiles.
      allow delete: if false;
    }
  }
}
